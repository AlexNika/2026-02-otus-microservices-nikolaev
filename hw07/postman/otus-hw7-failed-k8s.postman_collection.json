    {
      "name": "07 - Create order (1000 RUB, insufficient funds)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 502 (billing rejected withdrawal)\", function () {",
              "    pm.response.to.have.status(502);",
              "});",
              "",
              "pm.test(\"Error response has message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "    pm.expect(jsonData.message).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "console.log(\"Order creation failed as expected: \" + jsonData.message);",
              "console.log(\"ORDERService should have published FAILED NotificationEvent to RabbitMQ\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": {{userId}},\n    \"price\": 1000,\n    \"description\": \"HW7 FAILED scenario test order (insufficient funds)\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "order"
          ]
        },
        "description": "Создание заказа на 1000 руб. при нулевом балансе. BILLINGService отклоняет списание (Insufficient funds), ORDERService возвращает 502 и публикует NotificationEvent(status=FAILED) в RabbitMQ."
      },
      "response": []
    },
    {
      "name": "08 - Get FAILED notification (poll)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// При повторных попытках ждём 1 секунду, чтобы событие успело пройти через RabbitMQ",
              "var attempt = parseInt(pm.collectionVariables.get(\"pollAttempt\") || \"1\", 10);",
              "if (attempt > 1) {",
              "    console.log(\"Waiting 1000 ms before attempt #\" + attempt + \"...\");",
              "    setTimeout(function () {}, 1000);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var maxAttempts = 10;",
              "var attempt = parseInt(pm.collectionVariables.get(\"pollAttempt\") || \"1\", 10);",
              "var expectedUserId = Number(pm.collectionVariables.get(\"userId\"));",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var notifications = [];",
              "try {",
              "    notifications = pm.response.json();",
              "} catch (e) {",
              "    notifications = [];",
              "}",
              "",
              "// Заказ при ошибке биллинга не сохраняется (откат транзакции), orderId из ответа неизвестен.",
              "// Пользователь свежесозданный, поэтому у него ровно одно уведомление - FAILED.",
              "var found = notifications.some(function (n) {",
              "    return n.notificationStatus === \"FAILED\"",
              "        && Number(n.userId) === expectedUserId;",
              "});",
              "",
              "if (found) {",
              "    pm.test(\"FAILED notification event found for userId \" + expectedUserId, function () {",
              "        pm.expect(found).to.be.true;",
              "    });",
              "    var notification = notifications.find(function (n) {",
              "        return n.notificationStatus === \"FAILED\" && Number(n.userId) === expectedUserId;",
              "    });",
              "    console.log(\"FAILED notification found: \" + JSON.stringify(notification));",
              "    pm.collectionVariables.set(\"pollAttempt\", \"1\");",
              "} else if (attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": FAILED notification not found yet, retrying...\");",
              "    pm.collectionVariables.set(\"pollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"pollAttempt\", \"1\");",
              "    pm.test(\"FAILED notification event found for userId \" + expectedUserId, function () {",
              "        pm.expect(found).to.be.true;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notification?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notification"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        },
        "description": "Опрос NOTIFICATIONService до появления уведомления FAILED по данному пользователю (до 10 попыток с паузой 1 с). ВНИМАНИЕ: двойной слэш в пути — так замаплен NotificationController (api/v1/notification)."
      },
      "response": []
    }
