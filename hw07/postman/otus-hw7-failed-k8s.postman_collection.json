    {
      "name": "05 - Register User (account auto-created)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Генерируем уникальные данные пользователя",
              "var timestamp = new Date().getTime();",
              "var randomSuffix = Math.floor(Math.random() * 100000);",
              "",
              "pm.collectionVariables.set(\"userName\", \"user_\" + timestamp + \"_\" + randomSuffix);",
              "pm.collectionVariables.set(\"userEmail\", \"user_\" + timestamp + \"_\" + randomSuffix + \"@test.com\");",
              "pm.collectionVariables.set(\"userFirstName\", \"First_\" + randomSuffix);",
              "pm.collectionVariables.set(\"userLastName\", \"Last_\" + randomSuffix);",
              "pm.collectionVariables.set(\"userPassword\", \"Password1!\");",
              "",
              "console.log(\"Registering user: \" + pm.collectionVariables.get(\"userEmail\"));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response body has id field\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"userId\", jsonData.id);",
              "console.log(\"User registered with ID: \" + jsonData.id + \" (billing account auto-created by USERService)\");",
              "",
              "pm.test(\"User data matches sent data\", function () {",
              "    pm.expect(jsonData.userName).to.eql(pm.collectionVariables.get(\"userName\"));",
              "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userName\": \"{{userName}}\",\n    \"firstName\": \"{{userFirstName}}\",\n    \"lastName\": \"{{userLastName}}\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "description": "Регистрация нового пользователя. USERService внутри вызывает BILLINGService и создаёт биллинг-аккаунт. Endpoint публичный (security дальше USERService не распространяется)."
      },
      "response": []
    },
    {
      "name": "06 - Get account by userId (balance = 0, no deposit)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Billing account auto-created with zero balance\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Number(jsonData.userId)).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "    pm.expect(Number(jsonData.balance)).to.eql(0);",
              "    pm.expect(jsonData.enabled).to.be.true;",
              "});",
              "",
              "console.log(\"Billing account verified: balance=0, no deposit will be made\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "user",
            "{{userId}}"
          ]
        },
        "description": "Проверка, что биллинг-аккаунт создан при регистрации и баланс = 0. Депозит намеренно не выполняется — денег на заказ не хватит."
      },
      "response": []
