          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Balance is 750 after order payment\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Number(jsonData.balance)).to.eql(750);",
              "});",
              "",
              "console.log(\"Balance after order verified: 750 RUB\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{billingServiceUrl}}/api/v1/account/user/{{userId}}",
          "host": [
            "{{billingServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "user",
            "{{userId}}"
          ]
        },
        "description": "Проверка, что деньги за заказ действительно списаны с аккаунта."
      },
      "response": []
    },
    {
      "name": "10 - Get SUCCESS notification (poll)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// При повторных попытках ждём 1 секунду, чтобы событие успело пройти через RabbitMQ",
              "var attempt = parseInt(pm.collectionVariables.get(\"pollAttempt\") || \"1\", 10);",
              "if (attempt > 1) {",
              "    console.log(\"Waiting 1000 ms before attempt #\" + attempt + \"...\");",
              "    setTimeout(function () {}, 1000);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var maxAttempts = 10;",
              "var attempt = parseInt(pm.collectionVariables.get(\"pollAttempt\") || \"1\", 10);",
              "var expectedUserId = Number(pm.collectionVariables.get(\"userId\"));",
              "var expectedOrderId = Number(pm.collectionVariables.get(\"orderId\"));",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var notifications = [];",
              "try {",
              "    notifications = pm.response.json();",
              "} catch (e) {",
              "    notifications = [];",
              "}",
              "",
              "var found = notifications.some(function (n) {",
              "    return n.notificationStatus === \"SUCCESS\"",
              "        && Number(n.orderId) === expectedOrderId",
              "        && Number(n.userId) === expectedUserId;",
              "});",
              "",
              "if (found) {",
              "    pm.test(\"SUCCESS notification event found for orderId \" + expectedOrderId, function () {",
              "        pm.expect(found).to.be.true;",
              "    });",
              "    var notification = notifications.find(function (n) {",
              "        return n.notificationStatus === \"SUCCESS\" && Number(n.orderId) === expectedOrderId;",
              "    });",
              "    console.log(\"SUCCESS notification found: \" + JSON.stringify(notification));",
              "    pm.collectionVariables.set(\"pollAttempt\", \"1\");",
              "} else if (attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": SUCCESS notification not found yet, retrying...\");",
              "    pm.collectionVariables.set(\"pollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"pollAttempt\", \"1\");",
              "    pm.test(\"SUCCESS notification event found for orderId \" + expectedOrderId, function () {",
              "        pm.expect(found).to.be.true;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{notificationServiceUrl}}/api/v1/notification?userId={{userId}}",
          "host": [
            "{{notificationServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notification"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        },
        "description": "Опрос NOTIFICATIONService до появления уведомления SUCCESS по созданному заказу (до 10 попыток с паузой 1 с). ВНИМАНИЕ: двойной слэш в пути — так замаплен NotificationController (api/v1/notification)."
      },
      "response": []
    }
