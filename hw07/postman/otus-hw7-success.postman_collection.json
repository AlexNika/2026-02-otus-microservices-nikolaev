    {
      "name": "08 - Create order (250 RUB, payment succeeds)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Order is PLACED (billing confirmed payment)\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.orderStatus).to.eql(\"PLACED\");",
              "    pm.expect(Number(jsonData.userId)).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "    pm.expect(Number(jsonData.price)).to.eql(250);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"orderId\", jsonData.id);",
              "console.log(\"Order created with ID: \" + jsonData.id + \", status=\" + jsonData.orderStatus);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": {{userId}},\n    \"price\": 250,\n    \"description\": \"HW7 SUCCESS scenario test order\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{orderServiceUrl}}/api/v1/order",
          "host": [
            "{{orderServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "order"
          ]
        },
        "description": "Создание заказа на 250 руб. ORDERService списывает деньги через BILLINGService и переводит заказ в PLACED, затем публикует NotificationEvent(status=PLACED) в RabbitMQ."
      },
      "response": []
    },
    {
      "name": "09 - Verify balance after order (1000 - 250 = 750)",
      "event": [
