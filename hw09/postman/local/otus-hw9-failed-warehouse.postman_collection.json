              "",
              "var orders = pm.response.json();",
              "pm.test(\"User has a FAILED order\", function () {",
              "    pm.expect(orders).to.be.an(\"array\");",
              "    var failed = orders.filter(function (o) { return o.orderStatus === \"FAILED\"; });",
              "    pm.expect(failed.length).to.be.above(0);",
              "});",
              "",
              "var failedOrder = orders.find(function (o) { return o.orderStatus === \"FAILED\"; });",
              "if (failedOrder) {",
              "    pm.collectionVariables.set(\"orderId\", failedOrder.id);",
              "    console.log(\"FAILED order ID: \" + failedOrder.id);",
