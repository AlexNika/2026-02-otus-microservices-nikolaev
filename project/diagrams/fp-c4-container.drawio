        </mxCell>
        <mxCell id="alloy-loki" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="Alloy (logging-alloy, DaemonSet)&#xa;+ Loki 7.3 (logging-loki)&#xa;[ns otus-msa-logging] · /loki&#xa;парсинг trace_id/span_id из логов" vertex="1">
          <mxGeometry height="100" width="300" x="720" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="tempo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="Tempo 1.24.4 (tracing-tempo)&#xa;[ns otus-msa-tracing]&#xa;OTLP :4317/:4318" vertex="1">
          <mxGeometry height="100" width="260" x="1100" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="grafana" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;" value="Grafana (monitoring-grafana)&#xa;[ns otus-msa-monitoring] · /grafana&#xa;дашборды «FP Business &amp; Patterns»,&#xa;Spring Boot 3.x, RabbitMQ, Node Exporter&#xa;DS: Prometheus / Loki / Tempo" vertex="1">
          <mxGeometry height="100" width="300" x="1440" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacing=8;" value="&lt;b&gt;Сплошные синие&lt;/b&gt;&amp;nbsp;- синхронный REST: публичный /api/v1/** через ingress; внутри кластера /internal/** - заголовок X-Internal-API-Key, по k8s DNS мимо ingress. Сага - только синхронный REST; клиенты ORDER (Billing/Warehouse/DeliveryServiceClient) под Resilience4j: CircuitBreaker + Retry + RateLimiter.&lt;br&gt;&lt;b&gt;Пунктирные зелёные&lt;/b&gt;&amp;nbsp;- 4 асинхронных канала AMQP: users.events/user.created; user.sync.events/user.profile.sync; accounts.events/account.created; notifications.events/notification.event (через outbox, DLQ); W3C traceparent/tracestate передаются в заголовках сообщений.&lt;br&gt;&lt;b&gt;Сплошные серые&lt;/b&gt;&amp;nbsp;- доступ к своей БД: JPA + Flyway (database-per-service, 7 × PostgreSQL 16).&lt;br&gt;&lt;b&gt;Пунктирные фиолетовые&lt;/b&gt;&amp;nbsp;- observability (cross-ns): Prometheus scrape /actuator/prometheus (7 сервисов) + rabbitmq :15692 + ingress-nginx :10254; трейсы OTLP HTTP → Tempo (все 7 сервисов, sampling 1.0); логи подов → Alloy → Loki (push); Grafana DS: Prometheus/Loki/Tempo (uid fp-prometheus/fp-loki/fp-tempo), derived field trace_id: переходы логи ↔ трейсы.&lt;br&gt;&lt;b&gt;Helm-релизы / namespace&lt;/b&gt;: finalproject → otus-msa-fp; monitoring → otus-msa-monitoring; logging → otus-msa-logging; tracing → otus-msa-tracing; ingress-nginx → ingress-nginx.&lt;br&gt;COMMONDomain - общая библиотека внутри каждого сервиса (не отдельный контейнер)." vertex="1">
          <mxGeometry height="114" width="1440" x="320" y="1350" as="geometry" />
        </mxCell>
        <object placeholders="1" c4Name="Покупатель" c4Type="Person" c4Description="Регистрируется, пополняет счёт, оформляет заказы, получает уведомления" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="p-buyer">
