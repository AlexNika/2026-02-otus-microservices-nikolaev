            <mxPoint x="1080" y="485" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: сага: BILLING withdraw → WAREHOUSE/DELIVERY reserve → confirm (см. диаграмму саги)" style="html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="545" as="sourcePoint" />
            <mxPoint x="750" y="580" as="targetPoint" />
            <Array as="points">
              <mxPoint x="870" y="545" />
              <mxPoint x="870" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: recordSuccess — сохранение ответа (responseStatus/responseBody) для replay; при провале — recordSagaStatus (ключ остаётся)" style="html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="620" as="sourcePoint" />
            <mxPoint x="1080" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8: 201 Created — новый заказ" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="670" as="sourcePoint" />
            <mxPoint x="120" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="div1" value="DataIntegrityViolationException при saveAndFlush — конкурентный повтор с тем же ключом → replay-путь" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;fontSize=10;fontColor=#666666;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="715" as="sourcePoint" />
            <mxPoint x="1125" y="715" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9: replay: чтение сохранённого ключа (SHA-256 хэш, владелец, responseStatus/responseBody)" style="html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="760" as="sourcePoint" />
            <mxPoint x="1080" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt3" value="alt — результат replay" style="shape=umlFrame;whiteSpace=wrap;html=1;width=190;height=30;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="795" width="1030" height="225" as="geometry" />
        </mxCell>
        <mxCell id="op1" value="SHA-256(payload) или владелец ≠ сохранённых" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="823" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="10: 409 IDEMPOTENCY_KEY_CONFLICT" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#B85450;fontColor=#B85450;fontSize=11;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="855" as="sourcePoint" />
            <mxPoint x="120" y="855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="div2" value="хэш и владелец совпадают; сохранён ответ" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;fontSize=10;fontColor=#666666;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="885" as="sourcePoint" />
            <mxPoint x="1125" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11: 201 — сохранённый ответ (REPLAYED_COMPLETED)" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="920" as="sourcePoint" />
            <mxPoint x="120" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="div3" value="хэш и владелец совпадают; ответа ещё нет (сага в процессе либо завершилась провалом)" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;fontSize=10;fontColor=#666666;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="950" as="sourcePoint" />
            <mxPoint x="1125" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12: 200 — текущее состояние заказа (REPLAYED_CURRENT)" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="985" as="sourcePoint" />
            <mxPoint x="120" y="985" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note1" value="Нет заголовка Idempotency-Key — поведение без изменений (обратная совместимость).&#10;Повтор ключа никогда не создаёт второй заказ: ключ резервируется атомарно с первым сохранением заказа (одна транзакция, saveAndFlush).&#10;Scheduled-очистка истёкших ключей: app.idempotency.ttl (по умолчанию 24ч), cleanupExpiredKeys.&#10;Внутренние шаги саги идемпотентны: ключ резерва склада — order-{orderId}-p{productId}." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1180" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
