        <mxCell id="m5" value="5: ОДНА транзакция (saveAndFlush): заказ PENDING + idempotency_keys (ключ, SHA-256 payload, владелец) + сага STARTED" style="html=1;endArrow=block;endFill=1;strokeColor=#438DD5;fontColor=#08427B;fontSize=11;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
