        <mxCell id="m1" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="1: NotificationEvent (eventId) + финализация заказа - ОДНА транзакция (обе ветки: PLACED и FAILED)">
