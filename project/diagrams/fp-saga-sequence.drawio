            <mxPoint x="335" y="1035" as="sourcePoint" />
            <mxPoint x="545" y="1035" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;" value="16: сага COMPENSATED; заказ → FAILED">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="475" y="1070" />
              <mxPoint x="475" y="1105" />
            </Array>
            <mxPoint x="335" y="1070" as="sourcePoint" />
