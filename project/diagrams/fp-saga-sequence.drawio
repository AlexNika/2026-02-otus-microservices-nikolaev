        </mxCell>
        <mxCell id="m17" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;" value="17: NotificationEvent (FAILED, eventId) → notification_outbox - одна транзакция с финализацией">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="475" y="1130" />
              <mxPoint x="475" y="1165" />
            </Array>
            <mxPoint x="335" y="1130" as="sourcePoint" />
            <mxPoint x="335" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m18" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;fontSize=11;" value="18: OutboxPublisher (@Scheduled): publish события FAILED">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="1210" as="sourcePoint" />
            <mxPoint x="1155" y="1210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m19" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;fontSize=11;" value="19: consume → уведомление FAILED (дедупликация по eventId)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1155" y="1270" as="sourcePoint" />
            <mxPoint x="1335" y="1270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m20" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#B85450;fontSize=11;" value="20: 409 ErrorDto{code} (напр. DELIVERY_NO_FREE_COURIER)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="1330" as="sourcePoint" />
            <mxPoint x="125" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=12;" value="Транзитные ошибки (5xx, таймауты, 409 CONCURRENT_MODIFICATION) ретраятся до 3 попыток (backoff 200мс ×2, SagaStepRetrier); бизнес-отказы - немедленная компенсация.&lt;br&gt;Компенсации строго в обратном порядке и только по фактически выполненным шагам (delivery.cancel → warehouse.cancel → billing.refund); все шаги идемпотентны - повторы шагов/компенсаций и ретраи безопасны.&lt;br&gt;Все синхронные вызовы - REST /internal/** с заголовком X-Internal-API-Key по k8s DNS мимо ingress; HTTP-вызовы вне транзакции БД (createOrder без @Transactional, состояние - короткие транзакции).&lt;br&gt;Зависшие саги доводятся scheduled-recovery (SagaRecoveryService): пробы состояния через read-эндпоинты (withdraw-status, статусы резервов). Состояние саги - таблица order_saga_state." vertex="1">
          <mxGeometry height="120" width="1420" x="40" y="1450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
