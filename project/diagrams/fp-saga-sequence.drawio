        <mxCell id="m10" edge="1" parent="1" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;fontSize=11;" value="10: OutboxPublisher (@Scheduled): publish → notifications.events / notification.event (mandatory, correlationId=eventId)">
