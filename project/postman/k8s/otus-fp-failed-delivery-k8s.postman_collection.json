    {
      "name": "07a - Probe existing courier reservations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Антиколлизия: на этой дате могли остаться резервы доставки от прошлых прогонов.",
              "// Читаем фактическую занятость слотов и пересчитываем courierCount.",
              "// Целевой слот обязан быть самым занятым: S4a занимает последнее место, S4b падает.",
              "pm.test(\"Probe response is 200 or 404\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});",
              "",
              "var N = 1; // S4a займёт последнее место в слоте, второму заказу мест не останется",
              "",
              "if (pm.response.code === 404) {",
              "    // Ёмкость на дату ещё не задана: резервов нет, слот остаётся как настроен в шаге 01.",
              "    pm.collectionVariables.set(\"reservedMax\", \"0\");",
              "    pm.collectionVariables.set(\"courierCount\", String(N));",
              "    console.log(\"Capacity probe: 404, reservedMax=0, courierCount=\" + N",
              "        + \", slot=\" + pm.collectionVariables.get(\"slotStart\") + \"-\" + pm.collectionVariables.get(\"slotEnd\"));",
              "} else {",
              "    var jsonData = pm.response.json();",
              "    var slots = jsonData.slots || [];",
              "    pm.test(\"Capacity response has slots\", function () {",
              "        pm.expect(slots).to.be.an(\"array\").that.is.not.empty;",
              "    });",
              "    var busiest = slots.reduce(function (a, b) {",
              "        return (b.reservedCount || 0) > (a.reservedCount || 0) ? b : a;",
              "    });",
              "    var reservedMax = busiest.reservedCount || 0;",
              "    pm.collectionVariables.set(\"slotStart\", busiest.slotStart);",
              "    pm.collectionVariables.set(\"slotEnd\", busiest.slotEnd);",
              "    pm.collectionVariables.set(\"reservedMax\", String(reservedMax));",
              "    pm.collectionVariables.set(\"courierCount\", String(reservedMax + N));",
              "    console.log(\"Capacity probe: 200, busiest slot \" + busiest.slotStart + \"-\" + busiest.slotEnd",
              "        + \", reservedMax=\" + reservedMax + \", courierCount=\" + (reservedMax + N));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
