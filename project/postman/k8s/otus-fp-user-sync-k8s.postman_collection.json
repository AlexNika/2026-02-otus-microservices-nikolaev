    {
      "name": "06 - GET profile (capture address ids)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Profile is created asynchronously after registration",
              "// (AUTH outbox -> users.events -> USERService consumer): poll until it appears.",
              "var maxAttempts = 15;",
              "var attempt = parseInt(pm.collectionVariables.get(\"syncPollAttempt\") || \"1\", 10);",
              "",
              "if (pm.response.code === 404 && attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": profile not created yet, retrying GET profile...\");",
              "    pm.collectionVariables.set(\"syncPollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"syncPollAttempt\", \"1\");",
              "",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    var jsonData = pm.response.json();",
              "    pm.test(\"Profile contains phone and 2 addresses with created ids\", function () {",
              "        pm.expect(jsonData.phone).to.eql(pm.collectionVariables.get(\"phoneInitial\"));",
              "        pm.expect(jsonData.addresses).to.be.an(\"array\").with.lengthOf(2);",
              "        jsonData.addresses.forEach(function (a) {",
              "            pm.expect(a.addressId).to.be.a(\"number\");",
              "        });",
              "    });",
              "",
              "    pm.collectionVariables.set(\"addressId1\", jsonData.addresses[0].addressId);",
              "    pm.collectionVariables.set(\"addressId2\", jsonData.addresses[1].addressId);",
              "    console.log(\"Captured address ids: \" + jsonData.addresses[0].addressId + \", \" + jsonData.addresses[1].addressId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
