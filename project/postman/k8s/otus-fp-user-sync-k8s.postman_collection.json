    {
      "name": "08 - NOTIFICATION internal contacts (replicated phone/email)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Пауза 5 c (busy-wait): outbox-планировщик публикует UserSyncEvent с циклом ~1 c,",
              "// consumer применяет read-модель. При нестабильном окружении перезапустите запрос.",
              "var waitUntil = Date.now() + 5000;",
              "while (Date.now() < waitUntil) { /* wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Contact read-model is updated asynchronously by the NOTIFICATIONService consumer",
              "// after the profile event: poll until the updated phone is replicated.",
              "var maxAttempts = 15;",
              "var attempt = parseInt(pm.collectionVariables.get(\"syncPollAttempt\") || \"1\", 10);",
              "",
              "var ready = false;",
              "if (pm.response.code === 200) {",
              "    var contact = pm.response.json();",
              "    ready = contact && contact.phone === pm.collectionVariables.get(\"phoneUpdated\");",
              "}",
              "",
              "if (!ready && attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": NOTIFICATION read-model not replicated yet, retrying...\");",
              "    pm.collectionVariables.set(\"syncPollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"syncPollAttempt\", \"1\");",
              "",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    var jsonData = pm.response.json();",
              "    pm.test(\"Contact read-model replicated: userId, email and updated phone\", function () {",
              "        pm.expect(Number(jsonData.userId)).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "        pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
              "        pm.expect(jsonData.phone).to.eql(pm.collectionVariables.get(\"phoneUpdated\"));",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Internal-API-Key",
            "value": "{{internalApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/contacts/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "contacts",
            "user",
            "{{userId}}"
          ]
        },
        "description": "Read-модель контактов NOTIFICATIONService после репликации UserSyncEvent."
      },
      "response": []
    },
    {
      "name": "09 - DELIVERY internal user-addresses (replicated snapshot)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Address read-model snapshot is updated asynchronously by the DELIVERYService consumer",
              "// after the profile event: poll until the update is reflected.",
              "var maxAttempts = 15;",
              "var attempt = parseInt(pm.collectionVariables.get(\"syncPollAttempt\") || \"1\", 10);",
              "",
              "var id1 = Number(pm.collectionVariables.get(\"addressId1\"));",
              "var id2 = Number(pm.collectionVariables.get(\"addressId2\"));",
              "",
              "var ready = false;",
              "if (pm.response.code === 200) {",
              "    var snapshot = pm.response.json();",
              "    if (Array.isArray(snapshot) && snapshot.length === 2) {",
              "        var kept = snapshot.find(function (a) { return Number(a.sourceAddressId) === id1; });",
              "        var removed = snapshot.find(function (a) { return Number(a.sourceAddressId) === id2; });",
              "        ready = !!kept && kept.fullAddress === \"Moscow, Tverskaya st. 7 apt 5\" && !removed;",
              "    }",
              "}",
              "",
              "if (!ready && attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": DELIVERY read-model not replicated yet, retrying...\");",
              "    pm.collectionVariables.set(\"syncPollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"syncPollAttempt\", \"1\");",
              "",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    var list = pm.response.json();",
              "",
              "    pm.test(\"Address read-model replicated: exactly 2 addresses without duplicates\", function () {",
              "        pm.expect(list).to.be.an(\"array\").with.lengthOf(2);",
              "        var ids = list.map(function (a) { return Number(a.sourceAddressId); });",
              "        pm.expect(new Set(ids).size).to.eql(ids.length);",
              "    });",
              "",
              "    pm.test(\"Updated address kept, deleted address absent, new address present\", function () {",
              "        var kept = list.find(function (a) { return Number(a.sourceAddressId) === id1; });",
              "        pm.expect(kept, \"addressId1 must be present\").to.not.be.undefined;",
              "        pm.expect(kept.fullAddress).to.eql(\"Moscow, Tverskaya st. 7 apt 5\");",
              "        pm.expect(kept.isDefault).to.eql(false);",
              "",
              "        var removed = list.find(function (a) { return Number(a.sourceAddressId) === id2; });",
              "        pm.expect(removed, \"addressId2 must be removed\").to.be.undefined;",
              "",
              "        var added = list.find(function (a) { return Number(a.sourceAddressId) !== id1; });",
              "        pm.expect(added).to.not.be.undefined;",
              "        pm.expect(added.fullAddress).to.eql(\"Kazan, Baumana st. 12\");",
              "        pm.expect(added.isDefault).to.eql(true);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Internal-API-Key",
            "value": "{{internalApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/delivery/user-addresses/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "delivery",
            "user-addresses",
            "{{userId}}"
          ]
        },
        "description": "Read-модель адресов DELIVERYService после репликации UserSyncEvent."
      },
      "response": []
    },
