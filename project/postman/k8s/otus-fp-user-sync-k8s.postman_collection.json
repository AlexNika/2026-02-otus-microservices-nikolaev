    {
      "name": "11 - NOTIFICATION internal contacts after duplicate event",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Пауза 5 c (busy-wait): ждём применение повторного UserSyncEvent.",
              "var waitUntil = Date.now() + 5000;",
              "while (Date.now() < waitUntil) { /* wait */ }"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Contact unchanged and without duplicates after duplicate delivery\", function () {",
              "    pm.expect(Number(jsonData.userId)).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
              "    pm.expect(jsonData.phone).to.eql(pm.collectionVariables.get(\"phoneUpdated\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Internal-API-Key",
            "value": "{{internalApiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/contacts/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "contacts",
            "user",
            "{{userId}}"
          ]
        },
        "description": "Повторная проверка: одна запись, дубль не появился (PK user_id + dedup по eventId)."
      },
      "response": []
    },
    {
      "name": "12 - DELIVERY internal user-addresses after duplicate event",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var list = pm.response.json();",
              "var id1 = Number(pm.collectionVariables.get(\"addressId1\"));",
              "",
              "pm.test(\"Addresses unchanged and without duplicates after duplicate delivery\", function () {",
              "    pm.expect(list).to.be.an(\"array\").with.lengthOf(2);",
              "    var ids = list.map(function (a) { return Number(a.sourceAddressId); });",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);",
              "    var kept = list.find(function (a) { return Number(a.sourceAddressId) === id1; });",
              "    pm.expect(kept.fullAddress).to.eql(\"Moscow, Tverskaya st. 7 apt 5\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
