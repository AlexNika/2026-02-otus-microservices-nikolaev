          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "var id1 = Number(pm.collectionVariables.get(\"addressId1\"));",
              "var id2 = Number(pm.collectionVariables.get(\"addressId2\"));",
              "",
              "pm.test(\"Phone updated\", function () {",
              "    pm.expect(jsonData.phone).to.eql(pm.collectionVariables.get(\"phoneUpdated\"));",
              "});",
              "",
              "pm.test(\"Addresses replaced: updated id1 kept, id2 removed, new address added\", function () {",
              "    pm.expect(jsonData.addresses).to.be.an(\"array\").with.lengthOf(2);",
              "    var ids = jsonData.addresses.map(function (a) { return Number(a.addressId); });",
              "    pm.expect(ids).to.include(id1);",
              "    pm.expect(ids).to.not.include(id2);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
