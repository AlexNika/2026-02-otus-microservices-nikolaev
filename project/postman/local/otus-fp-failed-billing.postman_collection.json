    {
      "name": "07a - Probe existing courier reservations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Антиколлизия: на этой дате могли остаться резервы доставки от прошлых прогонов",
              "// (даты циклируются: завтра + runBase % 28). Читаем фактическую занятость слотов,",
              "// чтобы PUT courierCount не конфликтовал с активными резервами (409 DELIVERY_CAPACITY_CONFLICT).",
              "pm.test(\"Probe response is 200 or 404\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});",
              "",
              "if (pm.response.code === 404) {",
              "    pm.collectionVariables.set(\"courierCount\", \"1\");",
              "    console.log(\"Capacity probe: 404, courierCount=1\");",
              "} else {",
              "    var jsonData = pm.response.json();",
              "    var slots = jsonData.slots || [];",
              "    pm.test(\"Capacity response has slots\", function () {",
              "        pm.expect(slots).to.be.an(\"array\").that.is.not.empty;",
              "    });",
              "    var reservedMax = slots.reduce(function (m, s) {",
              "        return Math.max(m, s.reservedCount || 0);",
              "    }, 0);",
              "    pm.collectionVariables.set(\"courierCount\", String(reservedMax + 1));",
              "    console.log(\"Capacity probe: 200, reservedMax=\" + reservedMax + \", courierCount=\" + (reservedMax + 1));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{deliveryServiceUrl}}/api/v1/delivery/courier-capacity/{{deliveryDate}}",
          "host": [
            "{{deliveryServiceUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "delivery",
            "courier-capacity",
            "{{deliveryDate}}"
          ]
        },
        "description": "Зонд занятости слотов на дату доставки для расчёта бесконфликтного courierCount."
      },
      "response": []
    },
