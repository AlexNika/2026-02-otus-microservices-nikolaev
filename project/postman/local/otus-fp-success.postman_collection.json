    {
      "name": "10 - Get billing account (Account auto-created with zero balance)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Billing account is created asynchronously (USER publishes UserCreatedEvent via outbox ->",
              "// BILLING consumer creates the account), so right after registration a 404 is possible:",
              "// poll with the same request up to maxAttempts.",
              "var maxAttempts = 15;",
              "var attempt = parseInt(pm.collectionVariables.get(\"accountPollAttempt\") || \"1\", 10);",
              "var expectedUserId = Number(pm.collectionVariables.get(\"userId\"));",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    pm.test(\"Account auto-created with zero balance\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(Number(jsonData.userId)).to.eql(expectedUserId);",
              "        pm.expect(Number(jsonData.balance)).to.eql(0);",
              "        pm.expect(jsonData.enabled).to.be.true;",
              "    });",
              "    pm.collectionVariables.set(\"accountPollAttempt\", \"1\");",
              "} else if (pm.response.code === 404 && attempt < maxAttempts) {",
              "    console.log(\"Attempt \" + attempt + \"/\" + maxAttempts + \": billing account not created yet, retrying...\");",
              "    pm.collectionVariables.set(\"accountPollAttempt\", String(attempt + 1));",
              "    postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "    pm.collectionVariables.set(\"accountPollAttempt\", \"1\");",
              "    pm.test(\"Billing account exists (async creation)\", function () {",
              "        pm.expect(pm.response.code, \"Billing account was not created within \" + maxAttempts + \" attempts\").to.eql(200);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
